# 이 파일을 .env.local 로 복사해서 쓴다.
# 아래 두 값은 브라우저에 그대로 실리는 공개용 값이다. 서버용 비밀 키는 여기에 적지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://lpbjaraczpohtdwrqbok.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_m_GLsrHVypAhTaNbBNQ09Q_sJcUIzht

# 웹 푸시 키(VAPID). npx web-push generate-vapid-keys 로 만든다. 공개 키는 브라우저에 실린다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 아래 셋은 비밀 값이다. .env.local 과 배포 환경 변수에만 넣고 저장소에 올리지 않는다.
VAPID_PRIVATE_KEY=
SUPABASE_SECRET_KEY=
DISPATCH_SECRET=
